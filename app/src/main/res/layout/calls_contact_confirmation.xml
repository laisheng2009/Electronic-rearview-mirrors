<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calls_contact_confirmation"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/calls_contact_confirmation_background"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/calls_picker_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/calls_picker_title"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calls_picker_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/calls_picker_prompt"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/calls_picker_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/calls_picker_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="#FFFF8C8C"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/calls_picker_use"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/calls_contact_confirmation_button"
            android:text="@string/calls_picker_use"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/calls_picker_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/calls_contact_confirmation_cancel"
            android:text="@string/calls_picker_cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
